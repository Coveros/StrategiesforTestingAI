// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:2-3.11-bookworm",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [5000, 11434, 5001],

	// Boot-time defaults used before a local .env is created.
	"remoteEnv": {
		"PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}",
		"OLLAMA_MODEL": "llama3.2:1b",
		"AGENT_MODEL": "llama3.2:1b",
		"AGENT_REQUEST_TIMEOUT_SECONDS": "300",
		"AGENT_API_TIMEOUT_SECONDS": "300",
		"AGENT_MAX_EXECUTION_SECONDS": "240",
		"AGENT_MAX_EXECUTION_SECONDS_CREW": "120",
		"AGENT_BOOTSTRAP_ON_ZERO_TOOLS": "true",
		"OLLAMA_NUM_PARALLEL": "1",
		"OLLAMA_MAX_LOADED_MODELS": "1",
		"OLLAMA_NUM_CTX": "2048",
		"OLLAMA_CONTEXT_LENGTH": "2048",
		"OLLAMA_MAX_CONTEXT_CHARS": "6000",
		"OLLAMA_AGENT_CONTEXT_CHARS": "3000",
		"MAX_TOKENS": "160",
		"OLLAMA_KEEP_ALIVE": "30m",
		"OLLAMA_PREWARM_ENABLED": "false",
		"RAG_WARMUP_ENABLED": "true",
		"AGENT_WARMUP_ON_STARTUP": "true",
		"CLASSROOM_PREWARM_ENABLED": "false",
		"FLASK_DEBUG": "false",
		"ENABLE_RATE_LIMITING": "true",
		"MAX_CONCURRENT_INFERENCE_REQUESTS": "1",
		"MLFLOW_SERVER_WORKERS": "1",
		"MLFLOW_SERVER_ENABLE_JOB_EXECUTION": "false",
		"MLFLOW_SERVER_JOB_ENABLE_PERIODIC_TASKS": "false"
	},

	// Use interpreter-bound pip to avoid PATH ambiguity.
	"postCreateCommand": "bash .devcontainer/post-create.sh || echo 'Warning: post-create setup completed with warnings; post-start services will still run.'",
	"postStartCommand": "bash .devcontainer/post-start.sh",

	// Specify minimum host requirements for ML workloads (sentence-transformers, chromadb, etc.)
	"hostRequirements": {
		"cpus": 2,
		"memory": "4gb",
		"storage": "32gb"
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"github.copilot",
				"github.copilot-chat"
			]
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}

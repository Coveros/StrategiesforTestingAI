# Shared environment configuration for local development and Codespaces

# Local LLM (Ollama) Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
# How long Ollama keeps the model loaded after each request. Without this, idle gaps
# between queries cause a slow ~30-50s reload on the next query.
OLLAMA_KEEP_ALIVE=30m
RAG_WARMUP_ENABLED=false
AGENT_WARMUP_ON_STARTUP=false
CLASSROOM_PREWARM_ENABLED=false

# Agentic Mode Configuration (LangChain + Ollama)
AGENT_MODEL=llama3.2:1b
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOKENS=220
AGENT_MAX_ITERATIONS=6
AGENT_MAX_ITERATIONS_CREW=4
AGENT_MAX_EXECUTION_SECONDS=240
AGENT_MAX_EXECUTION_SECONDS_CREW=120
AGENT_REQUEST_TIMEOUT_SECONDS=300
AGENT_RUNTIME=auto
AGENT_CREW_ROUTER_MODE=heuristic
AGENT_CREW_SPECIALIST_MODE=direct
AGENT_CREW_ENABLE_VALIDATOR=false
AGENT_DETAILED_TRACING=true
AGENT_API_TIMEOUT_SECONDS=300
AGENT_BOOTSTRAP_ON_ZERO_TOOLS=auto

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5000
EXERCISE_HUB_ENABLE_INSTRUCTOR=False

# RAG System Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_TOKENS=600
TEMPERATURE=0.3

# Database Configuration
DB_PATH=./data/documents
VECTOR_DB_PATH=./vector_db
PERSIST_DIRECTORY=./chroma_db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/rag_system.log

# MLflow Tracing Configuration
ENABLE_MLFLOW_ASK_TRACING=true
ENABLE_MLFLOW_AGENT_TRACING=true
MLFLOW_EXPERIMENT_NAME=strategiesfortestingai
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_AUTOLOG_LANGCHAIN=true

# API endpoint throttling
ENABLE_RATE_LIMITING=true

# Security
SECRET_KEY=your_secret_key_here